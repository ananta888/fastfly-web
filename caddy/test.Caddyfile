http://:8080 {
	redir /fastfly /fastfly/ permanent

	@api path /fastfly/api/*
	handle @api {
		uri strip_prefix /fastfly
		reverse_proxy 127.0.0.1:8000
	}

	handle /fastfly/ws {
		uri strip_prefix /fastfly
		reverse_proxy 127.0.0.1:8000
	}

	handle /fastfly/* {
		uri strip_prefix /fastfly
		root * /home/krusty/fastfly/fastfly-web/dist/fastfly-web/browser
		try_files {path} /index.html
		file_server
	}

	handle {
		respond "FastFly läuft unter /fastfly/" 200
	}
}